{
  "name": "dory",
  "version": "0.1.0",
  "private": true,
  "description": "Dory - AI Gaming Companion System",
  "scripts": {
    "dev": "turbo run dev",
    "dev:game": "turbo run dev --filter=@dory/game-agent",
    "dev:voice": "turbo run dev --filter=@dory/voice-agent",
    "dev:gatekeeper": "turbo run dev --filter=@dory/gatekeeper-agent",
    "dev:persona": "turbo run dev --filter=@dory/persona-builder-agent",
    "build": "turbo run build",
    "build:shared": "turbo run build --filter=@dory/shared",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "postinstall": "bash scripts/patch-livekit-stdio.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
