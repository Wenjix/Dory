    "@livekit/agents-plugin-silero": "1.0.37",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "livekit-server-sdk": "^2.14.1",
    "fluent-ffmpeg": "^2.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
