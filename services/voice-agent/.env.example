# Voice Agent Configuration

# Server
PORT=4001

# ── LiveKit (required) ─────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Speech-to-Text: Deepgram ──────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Text-to-Speech: ElevenLabs ────────────────────────────────────────────
ELEVEN_API_KEY=your_elevenlabs_api_key
# TTS_MODEL=eleven_flash_v2_5
# TTS_VOICE_ID=X3fJc68cSPDZeyn9uKoS

# ── LLM (OpenAI-compatible — MUST support tool/function calling) ─────────
# The LLM MUST support OpenAI-compatible function calling.
# Two known-working options:

# Option A: OpenAI GPT-4o-mini (reliable)
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini

# Option B: Groq + Qwen (fast, free — same as readyplayerx)
# LLM_API_KEY=your_groq_api_key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3-32b
# ⚠️  Do NOT use llama models on Groq — they don't call tools properly

# Temperature (lower = more reliable tool calls)
# LLM_TEMPERATURE=0.7

# ── Game Agent (A2A) ─────────────────────────────────────────────────────
# URL of the game agent for A2A communication (voice agent → game agent)
GAME_AGENT_URL=http://localhost:3000
