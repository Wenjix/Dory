# Server
GAME_AGENT_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Minecraft
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_AUTH_MODE=offline

# LLM Provider - switch by changing LLM_PROVIDER
# Options: mistral, openai, anthropic
LLM_PROVIDER=mistral

# API Keys (only need the one matching your LLM_PROVIDER)
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MongoDB (memory system - run: docker compose up -d)
MONGODB_URI=mongodb://localhost:27017/dory

# Models (optional - each has a sensible default)
# MISTRAL_MODEL=mistral-large-latest
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# LLM_MODEL=                # generic override (provider-specific takes priority)

# AI Structure Builder (optional - uses a separate, more capable model)
# Recommended: gpt-5.2 for best spatial code generation
# Requires OPENAI_API_KEY to be set above
BUILDER_LLM_PROVIDER=openai
BUILDER_LLM_MODEL=gpt-5.2
