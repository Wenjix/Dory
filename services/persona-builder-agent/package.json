{
  "name": "@dory/persona-builder-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/index.ts",
    "build": "tsc && pnpm prisma:generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "ai": "^4.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@google/generative-ai": "^0.21.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^5.22.0",
    "@dory/shared": "workspace:*",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
